{
  "name": "alice-companion-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "build:api": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node node_modules/typescript/bin/tsc -p tsconfig.api.json",
    "dev:api": "npm run build:api && node dist/src/apps/api/main.js",
    "tts:moss:conda": ".miniconda/_conda create -y -p .conda-moss python=3.11 pip",
    "tts:moss:install": "npm run tts:moss:conda && .conda-moss/bin/python -m pip install -r scripts/moss_tts_onnx/requirements.txt",
    "tts:moss:start": ".conda-moss/bin/python scripts/moss_tts_onnx/service.py",
    "tts:genie:install": "npm run tts:moss:conda && .conda-moss/bin/python -m pip install -r scripts/genie_tts/requirements.txt",
    "tts:genie:start": ".conda-moss/bin/python scripts/genie_tts/service.py",
    "calendar:seed-holidays": "node --import tsx scripts/seed-calendar-holidays.ts",
    "test:selfie-api": "node scripts/test-selfie-image-api.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/shell-quote": "^1.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "better-sqlite3": "^12.10.0",
    "date-holidays": "^3.30.2",
    "ffmpeg-static": "^5.3.0",
    "openid-client": "^6.8.7",
    "qrcode": "^1.5.4",
    "shell-quote": "^1.9.0",
    "silk-wasm": "^3.3.2",
    "undici": "7.3.0",
    "werift": "^0.23.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@alice/types": ["src/packages/types/src/index.ts"],
      "@alice/config": ["src/packages/config/src/index.ts"],
      "@alice/agent": ["src/core/agent/src/index.ts"],
      "@alice/event-bus": ["src/core/event-bus/src/index.ts"],
      "@alice/input-buffer": ["src/core/input-buffer/src/index.ts"],
      "@alice/llm": ["src/core/llm/src/index.ts"],
      "@alice/output-router": ["src/core/output-router/src/index.ts"],
      "@alice/policy": ["src/core/policy/src/index.ts"],
      "@alice/router": ["src/core/router/src/index.ts"],
      "@alice/session": ["src/core/session/src/index.ts"],
      "@alice/feishu": ["src/plugins/feishu/src/index.ts"]
    }
  },
  "include": ["src/apps/**/*.ts", "src/core/**/*.ts", "src/plugins/**/*.ts", "src/packages/**/*.ts", "src/workers/**/*.ts", "src/tools/**/*.ts", "src/skills/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
